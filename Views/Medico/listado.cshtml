@using System.Linq
@model IEnumerable<AplicacionCitasMedicasDB.Models.Medico>

@{
    ViewData["Title"] = "Listado de Médicos";
    var filtro = ViewBag.Filtro as string ?? "";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="m-0">Médicos</h2>
    <a asp-action="Crear" class="btn btn-primary btn-brand">
        <i class="bi bi-plus-circle"></i> Nuevo Médico
    </a>
</div>

@if (TempData["mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Listado" class="row g-2">
            <div class="col-sm-12 col-md-6 col-lg-4 position-relative">
                <input type="text" id="filtro" name="filtro" value="@filtro"
                       class="form-control pe-5"
                       placeholder="Buscar por CMP, Nombre o Apellido" />

                <!-- La X que hace reload limpio -->
                <a asp-action="Listado"
                   class="position-absolute top-50 end-0 translate-middle-y me-3 text-muted text-decoration-none"
                   style="font-size:1.2rem;"
                   aria-label="Limpiar">
                    &times;
                </a>
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Buscar</button>
            </div>

        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(m => m.FirstOrDefault()!.IdMedico)</th>
                <th>@Html.DisplayNameFor(m => m.FirstOrDefault()!.CMP)</th>
                <th>@Html.DisplayNameFor(m => m.FirstOrDefault()!.Nombre)</th>
                <th>@Html.DisplayNameFor(m => m.FirstOrDefault()!.Apellido)</th>
                <th>Especialidad</th>
                <th>@Html.DisplayNameFor(m => m.FirstOrDefault()!.Telefono)</th>
                <th>@Html.DisplayNameFor(m => m.FirstOrDefault()!.Correo)</th>
                <th class="text-center" style="width:190px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No se encontraron resultados</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdMedico</td>
                        <td>@item.CMP</td>
                        <td>@item.Nombre</td>
                        <td>@item.Apellido</td>
                        <td>@(string.IsNullOrWhiteSpace(item.NombreEspecialidad) ? "—" : item.NombreEspecialidad)</td>
                        <td>@item.Telefono</td>
                        <td>@item.Correo</td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2 flex-nowrap">
                                <a asp-action="Detalle" asp-route-id="@item.IdMedico"
                                   class="btn btn-sm btn-outline-secondary">Detalles</a>

                                <a asp-action="Editar" asp-route-id="@item.IdMedico"
                                   class="btn btn-sm btn-outline-primary">Editar</a>

                                <form asp-action="Eliminar" method="post" class="d-inline" data-confirm="¿Eliminar médico?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.IdMedico" />
                                    <input type="hidden" name="filtro" value="@filtro" />
                                    <input type="hidden" name="page" value="@paginaActual" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- llamar a vista parcial para reutlizar -->
@await Html.PartialAsync("_PagerWithTotal", new
    {
        PaginaActual = ViewBag.PaginaActual,
        TotalPaginas = ViewBag.TotalPaginas,
        Action = "Listado",
        RouteValues = new { filtro = (string)ViewBag.Filtro },
        TotalRegistros = ViewBag.TotalRegistros
    })

