@model AplicacionCitasMedicasDB.Models.Medico
@{
    ViewData["Title"] = "Editar Médico";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="m-0">Editar Médico</h2>
        <a asp-action="Listado" class="btn btn-outline-secondary">Volver al listado</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Editar" method="post">
                @Html.AntiForgeryToken()

                <!-- Id oculto -->
                <input type="hidden" asp-for="IdMedico" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="CMP" class="form-label"></label>
                        <input asp-for="CMP" class="form-control" />
                        <span asp-validation-for="CMP" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Apellido" class="form-label"></label>
                        <input asp-for="Apellido" class="form-control" />
                        <span asp-validation-for="Apellido" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="IdEspecialidad" class="form-label">Especialidad</label>
                        <select asp-for="IdEspecialidad" class="form-select"
                                asp-items="ViewBag.Especialidades">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" type="email" class="form-control" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Listado" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
