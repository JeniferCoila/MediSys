@model AplicacionCitasMedicasDB.Models.Medico

@{
    ViewData["Title"] = "Nuevo Médico";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Nuevo Médico</h2>
    <a asp-action="Listado" class="btn btn-outline-secondary">Volver al listado</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Crear" method="post" novalidate>
            @* Validaciones generales *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                

                <div class="col-md-3">
                    <label asp-for="CMP" class="form-label"></label>
                    <input asp-for="CMP" class="form-control" placeholder="Ej. CMP12345" autofocus />
                    <span asp-validation-for="CMP" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="col-md-5">
                    <label asp-for="Apellido" class="form-label"></label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="IdEspecialidad" class="form-label"></label>
                    <select 
                        asp-for="IdEspecialidad" class="form-select" 
                        asp-items="@(new SelectList(ViewBag.Especialidades, "IdEspecialidad", "Nombre"))">
                        <option value="0">-- Seleccionar Especialidad --</option>
                    </select>
                    <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-control" placeholder="Ej. 987654321" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" type="email" class="form-control" placeholder="nombre@correo.com" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Listado" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
