@model AplicacionCitasMedicasDB.Models.Medico
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Nuevo Médico";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="m-0">Nuevo Médico</h2>
        <a asp-action="Listado" class="btn btn-outline-secondary">Volver al listado</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Crear" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="CMP" class="form-label"></label>
                        <input asp-for="CMP" class="form-control" placeholder="Ej. CMP01234" />
                        <span asp-validation-for="CMP" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Ana" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Apellido" class="form-label"></label>
                        <input asp-for="Apellido" class="form-control" placeholder="Ej. Torres" />
                        <span asp-validation-for="Apellido" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="IdEspecialidad" class="form-label"></label>
                        <select asp-for="IdEspecialidad" class="form-select"
                                asp-items="ViewBag.Especialidades">
                            <option value="">— Seleccione —</option>
                        </select>
                        <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" placeholder="Ej. 987654321" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" type="email" class="form-control" placeholder="nombre@clinica.com" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Foto</label>
                    <input type="file" name="foto" class="form-control" accept="image/*" />
                    <div class="form-text">Formatos: JPG, PNG, WEBP (máx. 2 MB).</div>
                </div>

                <!-- Campos NO visibles en 'Crear' (los maneja la BD)
                     IdMedico (Identity), Estado (DEFAULT 1),
                     FechaCreacion/Actualizacion/Baja, RowVersion, NombreEspecialidad -->

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-brand">Guardar</button>
                    <a asp-action="Listado" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
