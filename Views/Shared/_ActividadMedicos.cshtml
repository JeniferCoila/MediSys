@model IReadOnlyList<AplicacionCitasMedicasDB.Models.ViewModels.MedicoActividadVm>

<div class="card p-3 h-100">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h5 class="m-0">Actividad reciente de médicos</h5>
        <a asp-controller="Medico" asp-action="Listado" class="btn btn-sm btn-outline-secondary">Ver todo</a>
    </div>

    <ul class="list-group list-group-flush">
        @if (Model == null || !Model.Any())
        {
            <li class="list-group-item text-muted">Sin actividad reciente</li>
        }
        else
        {
            @foreach (var m in Model)
            {
                var esBaja = m.Tipo == "Baja";

                <li class="list-group-item d-flex align-items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(m.FotoUrl))
                    {
                        <img src="@m.FotoUrl" alt="Foto" class="rounded-circle" width="40" height="40" style="object-fit:cover;">
                    }
                    else
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-light border" style="width:40px;height:40px;">
                            <i class="bi bi-person fs-5 text-secondary"></i>
                        </div>
                    }

                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(esBaja ? "bg-danger" : "bg-success")">
                                @(esBaja ? "Baja" : "Alta")
                            </span>

                            @if (esBaja)
                            {
                                <a asp-controller="Admin"
                                   asp-action="ListadoMedicosBajas"
                                   class="fw-semibold text-decoration-none text-danger"
                                   title="Ver en Médicos dados de baja">
                                    @m.Nombre
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Medico"
                                   asp-action="Detalle"
                                   asp-route-id="@m.IdMedico"
                                   class="fw-semibold text-decoration-none"
                                   title="Ver detalle">
                                    @m.Nombre
                                </a>
                            }
                        </div>
                        <small class="text-muted">@m.FechaTexto</small>
                    </div>

                    <i class="bi @(esBaja ? "bi-person-dash text-danger" : "bi-person-plus text-success") fs-5"></i>
                </li>
            }
        }
    </ul>
</div>
