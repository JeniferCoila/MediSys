@{
    var rol = Context.Session.GetString("rol");
    var user = Context.Session.GetString("username");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediSys</title>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AplicacionCitasMedicasDB.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
               
        @if (!string.IsNullOrEmpty(user))
        {
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light navbar-medisys">
                <div class="container-fluid">

                    <!-- LOGO dinámico -->
                    <a class="navbar-brand d-flex align-items-center gap-2"
                    asp-controller="@(rol == "Administrador" ? "Admin" :
                                                                                  rol == "Médico" ? "Medico" :
                                                                                  rol == "Paciente" ? "Paciente" :
                                                                                  "Login")"
                    asp-action="Menu">
                        <img src="~/img/logo-medisys.svg" alt="Medisys" height="28" asp-append-version="true">
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">

                            @if (!string.IsNullOrEmpty(user))
                            {
                                @switch (rol)
                                {
                                    case "Administrador":

                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Admin" asp-action="Menu">Panel de Administración</a>
                                        </li>


                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Paciente" asp-action="Listado">Pacientes</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Medico" asp-action="Listado">Médicos</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" href="#">Usuarios</a>
                                        </li>


                                        //Drowdown para gestionar bajas

                                        <li class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle text-dark" href="#" id="bajasDropdown" role="button"
                                            data-bs-toggle="dropdown" aria-expanded="false">Gestionar Bajas</a>
                                            <ul class="dropdown-menu" aria-labelledby="bajasDropdown">
                                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="ListadoMedicosBajas">Médicos Dados de Baja</a></li>
                                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="ListadoPacientesBajas">Pacientes Dados de Baja</a></li>
                                            </ul>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Citas" asp-action="Listado">Citas</a>
                                        </li>
                                        break;

                                    case "Médico":
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Citas" asp-action="Listado">Mis Citas</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" href="#">Diagnósticos</a>
                                        </li>
                                        break;

                                    case "Paciente":
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" href="#">Mis Citas</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" href="#">Mi Perfil</a>
                                        </li>
                                        break;
                                }

                                <li class="nav-item ms-sm-auto">
                                    <a class="nav-link text-dark" asp-controller="Login" asp-action="Logout">Cerrar sesión</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Login" asp-action="Index">Login</a>
                                </li>
                            }
                        </ul>
                </div>
            </div>
        </nav>
        }
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()  <!-- se carga vista específica -->
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Medisys -
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Confirmación para cualquier <form data-confirm="...">
        document.addEventListener('submit', function (e) {
                 const f = e.target;

          // Caso eliminar
          const msg = f.getAttribute('data-confirm');
          if (msg) {
            e.preventDefault();
            Swal.fire({
              title: msg,
              text: 'Esta acción desactivará el registro.',
              icon: 'warning',
              showCancelButton: true,
              confirmButtonText: 'Sí, eliminar',
              cancelButtonText: 'Cancelar',
              reverseButtons: true
            }).then(r => { if (r.isConfirmed) f.submit(); });
            return;
          }

          // Caso restaurar
          const msgRestore = f.getAttribute('data-restore');
          if (msgRestore) {
            e.preventDefault();
            Swal.fire({
              title: msgRestore,
              text: 'El usuario será restaurado y volverá a estar activo.',
              icon: 'question',
              showCancelButton: true,
              confirmButtonText: 'Sí, restaurar',
              cancelButtonText: 'Cancelar',
              reverseButtons: true
            }).then(r => { if (r.isConfirmed) f.submit(); });
          }

        }, true);

                        // Marca activo según la URL actual
        (function(){
          const path = location.pathname.toLowerCase();
          document.querySelectorAll('.navbar .nav-link').forEach(a=>{
            try{
              const url = new URL(a.href, location.origin);
              if (path.startsWith(url.pathname.toLowerCase())) a.classList.add('active');
            }catch{}
          });
        })();
    </script>



</body>
</html>
