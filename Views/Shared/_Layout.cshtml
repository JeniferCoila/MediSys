@{
    var rol = Context.Session.GetString("rol");
    var user = Context.Session.GetString("username");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AplicacionCitasMedicasDB</title>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AplicacionCitasMedicasDB.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">AplicacionCitasMedicasDB</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (!string.IsNullOrEmpty(user))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>

                            @if (rol == "Administrador")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="#">Pacientes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="#">Médicos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="#">Usuarios</a>
                                </li>
                            }
                            else if (rol == "Médico")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="#">Mis Citas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="#">Diagnósticos</a>
                                </li>
                            }
                            else if (rol == "Paciente")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="#">Mis Citas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="#">Mi Perfil</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Login" asp-action="Logout">Cerrar sesión</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Login" asp-action="Index">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()  <!-- se carga vista específica -->
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AplicacionCitasMedicasDB -
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Confirmación para cualquier <form data-confirm="...">
        document.addEventListener('submit', function (e) {
          const f = e.target;
          const msg = f.getAttribute('data-confirm');
          if (!msg) return;             // si no hay data-confirm, sigue normal
          e.preventDefault();           // detiene el submit
          Swal.fire({
            title: msg,
            text: 'Esta acción desactivará el registro.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar',
            reverseButtons: true
          }).then(r => { if (r.isConfirmed) f.submit(); });
        }, true);
    </script>


</body>
</html>
